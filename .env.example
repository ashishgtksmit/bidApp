DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=openbid-backend
JWT_AUDIENCE=openbid-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# PR5 — OTP / password-reset (never log these secrets)
OTP_PEPPER=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=10

# PR5 — public endpoint rate limits (shared DB buckets)
RATE_LIMIT_CHECK_USER_PER_IP=60
RATE_LIMIT_CHECK_USER_PER_APPID=30
RATE_LIMIT_CHECK_USER_WINDOW_SECONDS=60
RATE_LIMIT_OTPCALL_PER_IP=20
RATE_LIMIT_OTPCALL_PER_APPID=5
RATE_LIMIT_OTPCALL_WINDOW_SECONDS=900
RATE_LIMIT_VERIFYOTP_PER_IP=60
RATE_LIMIT_VERIFYOTP_PER_APPID=20
RATE_LIMIT_VERIFYOTP_WINDOW_SECONDS=900

# Test-only (never enable in production)
# OTP_TEST_BYPASS_SMS=1
# OTP_TEST_FIXED_OTP=1234
