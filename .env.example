DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=openbid-backend
JWT_AUDIENCE=openbid-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# PR37 — JWT clock skew tolerance (seconds) for access + refresh decode
JWT_CLOCK_LEEWAY_SECONDS=30

# PR38 — immutable JWT subject (authSubjectId)
# When true (default): accept valid PR37 phone-sub access/refresh during compatibility.
# When false: phone-sub access/refresh → SESSION_INVALID. Version-2 tokens unaffected.
JWT_ALLOW_LEGACY_PHONE_SUB=true
# Mint identity version for new login/refresh pairs (2 = authSubjectId sub; 1 = emergency phone-sub rollback only).
JWT_IDENTITY_VERSION_TO_MINT=2

# PR37 — refresh rate limits (fail closed)
RATE_LIMIT_REFRESH_VALID_PER_SESSION=20
RATE_LIMIT_REFRESH_VALID_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_INVALID_PER_BUCKET=10
RATE_LIMIT_REFRESH_INVALID_WINDOW_SECONDS=900

# PR5 — OTP / password-reset (never log these secrets)
OTP_PEPPER=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=10

# PR5 — public endpoint rate limits (shared DB buckets)
RATE_LIMIT_CHECK_USER_PER_IP=60
RATE_LIMIT_CHECK_USER_PER_APPID=30
RATE_LIMIT_CHECK_USER_WINDOW_SECONDS=60
RATE_LIMIT_OTPCALL_PER_IP=20
RATE_LIMIT_OTPCALL_PER_APPID=5
RATE_LIMIT_OTPCALL_WINDOW_SECONDS=900
RATE_LIMIT_VERIFYOTP_PER_IP=60
RATE_LIMIT_VERIFYOTP_PER_APPID=20
RATE_LIMIT_VERIFYOTP_WINDOW_SECONDS=900

# Test-only (never enable in production)
# OTP_TEST_BYPASS_SMS=1
# OTP_TEST_FIXED_OTP=1234

# PR18 — post-commit vendor snapshot refresh (same convention as openbid-ws)
# WORKER_BASE_URL=https://<funcapp>.azurewebsites.net/api
# BUILD_SNAPSHOT_FUNCTION_KEY=

# PR39/PR40 — transactional domain-event outbox
# Master + per-event flags must both be true to emit. All defaults safely false.
# Poller remains the propagation path when flags are off.
# Production enablement is a staged operational step (not part of code deploy).
DOMAIN_EVENTS_ENABLED=false
DOMAIN_EVENT_BID_CREATED_ENABLED=false
DOMAIN_EVENT_BID_UPDATED_ENABLED=false
DOMAIN_EVENT_BID_DELETED_ENABLED=false
DOMAIN_EVENT_BID_ACCEPTED_ENABLED=false
DOMAIN_EVENT_HANDSHAKE_CANCELLED_ENABLED=false
DOMAIN_EVENT_HANDSHAKE_ACCEPTED_ENABLED=false
DOMAIN_EVENT_HANDSHAKE_REJECTED_ENABLED=false
DOMAIN_EVENT_BOOKING_CANCELLED_BY_CUSTOMER_ENABLED=false
DOMAIN_EVENT_DRIVER_ASSIGNMENT_CHANGED_ENABLED=false
# PR43 — request.created Connected-First marketplace (default FALSE; do not enable until M5 + canary)
DOMAIN_EVENT_REQUEST_CREATED_ENABLED=false
# PR44 — request.updated Connected-First marketplace (default FALSE; do not enable until request.created canary PASS)
DOMAIN_EVENT_REQUEST_UPDATED_ENABLED=false

# PR43 — WSS/worker presence HMAC (prefer dedicated key; JWT_SECRET is fallback only)
# OPENBID_PRESENCE_HMAC_KEY=
# OPENBID_PRESENCE_TTL_SECONDS=60


# PR25 — internal authorization for generic notification dispatch routes
# Also required for PR31 restricted POST /sendemail (same shared secret).
# Required for POST /notificationtodriver, /sendfcmnotification,
# /sendnotificationtoselecteddrivers, /sendnotificationtoalldrivers,
# /sendmarketingnotificationtonumbers, /sendmarketingnotificationtoallusers,
# and POST /sendemail.
# Ordinary mobile JWTs alone are insufficient. Never commit a real secret.
# Header: X-OpenBid-Internal-Key
INTERNAL_NOTIFICATION_KEY=

# PR31 — restricted internal generic email (POST /sendemail; hidden from OpenAPI)
# Sender must be one of the SMTP map keys in utils/email.py.
# Empty recipient allow-lists fail closed (no delivery).
INTERNAL_EMAIL_FROM=customersupport@wizzride.com
INTERNAL_EMAIL_ALLOWED_RECIPIENTS=
INTERNAL_EMAIL_ALLOWED_DOMAINS=

# Firebase Admin (FCM messaging + PR26 RTDB chat message verification)
# FIREBASE_SERVICE_ACCOUNT must be the OpenBid service-account JSON string
# for project opnbd-a23e1. Never commit real credentials.
FIREBASE_SERVICE_ACCOUNT=
# OpenBid Realtime Database URL (required for POST /chat/notifications)
FIREBASE_DATABASE_URL=https://opnbd-a23e1-default-rtdb.asia-southeast1.firebasedatabase.app

# PR26 — chat notification rate limits (optional overrides)
# RATE_LIMIT_CHAT_NOTIFICATION_SENDER_PER_MIN=30
# RATE_LIMIT_CHAT_NOTIFICATION_PAIR_PER_MIN=20
# RATE_LIMIT_CHAT_NOTIFICATION_WINDOW_SECONDS=60
# RATE_LIMIT_CHAT_NOTIFICATION_MESSAGE_WINDOW_SECONDS=2592000


# PR28 — Azure chat-docs (public chat media; never commit real SAS)
AZURE_CHAT_DOCS_CONTAINER_URL=
AZURE_CHAT_DOCS_SAS=

# PR28 — chat media rate limits (optional overrides)
# RATE_LIMIT_CHAT_MEDIA_SENDER_PER_MIN=20
# RATE_LIMIT_CHAT_MEDIA_PAIR_PER_MIN=15
# RATE_LIMIT_CHAT_MEDIA_WINDOW_SECONDS=60
# RATE_LIMIT_CHAT_MEDIA_MESSAGE_WINDOW_SECONDS=2592000

# PR29 — missing location report operational email (never commit real addresses/secrets)
LOCATION_REPORT_EMAIL_TO=
LOCATION_REPORT_EMAIL_CC=
LOCATION_REPORT_EMAIL_BCC=
LOCATION_REPORT_EMAIL_FROM=customersupport@wizzride.com

# SMTP accounts used by app_v1/utils/email.py (required for location reports + other mail)
# Never commit real credentials.
SMTP_RESERVATIONS_USERNAME=
SMTP_RESERVATIONS_PASSWORD=
SMTP_CUSTOMERSUPPORT_USERNAME=
SMTP_CUSTOMERSUPPORT_PASSWORD=
SMTP_FALLBACK_USERNAME=
SMTP_FALLBACK_PASSWORD=

# PR29 — optional rate-limit overrides
# RATE_LIMIT_LOCATION_REPORT_SENDER_PER_HOUR=5
# RATE_LIMIT_LOCATION_REPORT_SENDER_WINDOW_SECONDS=3600
# RATE_LIMIT_LOCATION_REPORT_SAME_LOCATION_PER_DAY=1
# RATE_LIMIT_LOCATION_REPORT_SAME_LOCATION_WINDOW_SECONDS=86400

